{
  "version": 6,
  "configurePresets": [
    {
      "name": "xen-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${XEN_INSTALL_ROOT}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "xen-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "xen-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "editor",
      "displayName": "Editor (game module for XED)",
      "description": "Builds the game module XED loads. RelWithDebInfo: the same C++ runtime as XED's Release engine, with debug info for attaching a debugger to XED.",
      "inherits": "xen-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "editor",
      "configurePreset": "editor",
      "targets": ["${GAME_CLASS}Module"]
    }
  ]
}
