#pragma once

#include <Xen/AssetSettings.hpp>

namespace Xen::Generated {
    inline AssetSettings GameSettings() {
        AssetSettings Settings;
        Settings.PakFiles                    = { @XEN_GEN_PAK_FILES@,
                                                 @XEN_ENGINE_SHADERS_PAK@,
                                                 @XEN_ENGINE_ENVIRONMENT_PAK@ };
        Settings.ContentDirs                 = { @XEN_GEN_CONTENT_DIRS@ };
        Settings.AllowCommandLineContentDirs = @XEN_GEN_ALLOW_CLI_DIRS@;

#ifdef NDEBUG
        Settings.MountContentDirs = @XEN_GEN_LOOSE_IN_RELEASE@;
#else
        Settings.MountContentDirs      = !Settings.ContentDirs.empty();
        Settings.EngineShaderSourceDir = @XEN_ENGINE_SHADER_SOURCE_DIR@;
        Settings.EngineShaderOutputDir = @XEN_ENGINE_SHADER_OUTPUT_DIR@;
        Settings.EngineDxcPath         = @XEN_ENGINE_DXC_PATH@;
#endif

        return Settings;
    }
}