#######################################################
#=                   [ VENDORED ]                    =#
# Entire directories
Scripts/* linguist-vendored
Source/Vendor/* linguist-vendored
Source/Sandbox/Config/* linguist-vendored
Source/Sandbox/Content/* linguist-vendored
Source/Tools/XED/Config/* linguist-vendored
Source/Tools/XED/Resource/* linguist-vendored
# Specific files
CMakeLists.txt linguist-vendored
# File extenions
*.rc linguist-vendored
*.txt linguist-vendored
*.cmake linguist-vendored
*.ps1 linguist-vendored
*.py linguist-vendored
#=              [ LANGUAGE DEFINITIONS ]             =#
# File extensions
*.h linguist-language=C++
*.h.in linguist-language=C++
*.inl linguist-language=C++
*.wav filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# Batch files must stay CRLF (labels/goto break with LF-only line endings)
*.bat text eol=crlf
